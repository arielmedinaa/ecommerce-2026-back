# syntax=docker/dockerfile:1.4

FROM node:20-alpine AS deps
WORKDIR /usr/src/app

# dl-cdn.alpinelinux.org uses geo-balanced DNS that intermittently returns a
# transient DNS error inside this build sandbox — retry instead of failing.
RUN for i in 1 2 3 4 5; do apk add --no-cache vips-dev python3 make g++ libc6-compat && break || sleep 3; done

COPY package*.json ./
COPY yarn.lock ./
COPY nest-cli.json ./
COPY tsconfig.json ./
COPY tsconfig.prod.json ./
COPY tsconfig.paths.json ./

# yarn.lock pins resolved URLs against registry.yarnpkg.com regardless of the
# configured registry, and that host hits the same transient build-sandbox DNS
# error as dl-cdn above — retry instead of failing.
RUN --mount=type=cache,target=/root/.yarn \
    yarn config set network-timeout 600000 && \
    yarn config set registry https://registry.npmjs.org/ && \
    for i in 1 2 3 4 5; do yarn install --network-timeout 600000 --ignore-engines && break || sleep 3; done

FROM deps AS build
WORKDIR /usr/src/app

COPY .swcrc ./
COPY api-gateway/ ./api-gateway/
COPY microservices/ ./microservices/
COPY shared/ ./shared/

# Los tres arboles son independientes, asi que se compilan en paralelo.
# tsc-alias va despues porque reescribe los alias sobre el dist ya emitido.
RUN --mount=type=cache,target=/root/.swc \
    npx swc ./api-gateway/src -d dist & \
    npx swc ./microservices -d dist & \
    npx swc ./shared -d dist & \
    wait && \
    npx tsc-alias -p tsconfig.prod.json

FROM node:20-alpine AS runtime
WORKDIR /usr/src/app
ARG SERVICE_MAIN

RUN apk add --no-cache vips libc6-compat curl

COPY --from=deps /usr/src/app/node_modules ./node_modules
COPY --from=build /usr/src/app/dist ./dist

ENV NODE_ENV=production
ENV SERVICE_MAIN=${SERVICE_MAIN}

CMD ["sh", "-c", "node ${SERVICE_MAIN}"]
