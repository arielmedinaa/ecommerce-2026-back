NODE_ENV=production
CORS_ORIGIN=http://localhost:3000
API_GATEWAY_URL=http://localhost:3100/api
STOREFRONT_URL=http://localhost:3000

DATABASE_HOST=mariadb
DATABASE_PORT=3306
DATABASE_USER=ecommerce
DATABASE_PASSWORD=ecommerce
DATABASE_NAME=ecommerce
DATABASE_HOST_REPLIC=mariadb
DATABASE_PORT_REPLIC=3306
DATABASE_USER_REPLIC=ecommerce
DATABASE_PASSWORD_REPLIC=ecommerce
DATABASE_NAME_REPLIC=ecommerce
COMBOS_DB_NAME=combos
COMBOS_DB_NAME_REPLIC=combos
MARIADB_ROOT_PASSWORD=ecommerce_root

SYNCRONICE=false
DB_RETRY_ATTEMPTS=30
DB_RETRY_DELAY_MS=3000
DB_CONNECT_TIMEOUT_MS=10000

JWT_SECRET=change-me-in-production

REDIS_URL=redis://redis:6379
NATS_URL=nats://nats:4222

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localstack:4566
PAYMENTS_SQS_QUEUE_NAME=payments-jobs
PAYMENTS_SQS_WORKER_ENABLED=true

IMAGE_STORAGE_PROVIDER=s3
IMAGE_S3_ENDPOINT=http://localstack:4566
IMAGE_S3_BUCKET=ecommerce-images
IMAGE_S3_KEY_PREFIX=banners
IMAGE_S3_ENSURE_BUCKET=true
IMAGE_S3_SIGNED_URLS=true
IMAGE_S3_SIGNED_URL_TTL_SECONDS=300
IMAGE_S3_EXTERNAL_BASE_URL=http://localhost:4566/ecommerce-images
IMAGE_CDN_BASE_URL=

CORREO_SERVER=smtp.gmail.com
CORREO_PORT=587
CORREO_NOMBRE=Central Shop
CORREO_CUENTA=change-me@example.com
CORREO_PASS=change-me

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3101/auth/google/callback

VAPID_PUBLIC_KEY=change-me
VAPID_PRIVATE_KEY=change-me
VAPID_SUBJECT=mailto:change-me@example.com

VPOS_CLAVE_PUBLICA=change-me
VPOS_CLAVE_PRIVADA=change-me
VPOS_URL_API=https://vpos.infonet.com.py:8888
VPOS_RETURN_URL=http://localhost:3000/checkout/return
VPOS_CANCEL_URL=http://localhost:3000/checkout/cancel
VPOS_CONFIRMATION_URL=http://localhost:3100/api/payments/vpos/confirmation

# Agente ETL (Dropshipping) — NUNCA commitear la key real, solo en el .env local
ANTHROPIC_API_KEY=
ETL_CLAUDE_MODEL=claude-sonnet-5
ETL_DEFAULT_CRON=0 */6 * * *
