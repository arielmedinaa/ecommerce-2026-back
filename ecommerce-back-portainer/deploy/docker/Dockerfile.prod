# Dockerfile de producción genérico, reusado por los 9 servicios (api-gateway +
# 8 microservicios) vía build ARG.
#
# El monorepo se compila COMPLETO (api-gateway/, microservices/, shared/) con
# tsconfig.prod.json (misma relajación de "strict" que ya usan los
# microservicios en dev, para no introducir bugs de tipado nuevos en este
# cambio) + tsc-alias (resuelve los path aliases @shared/*, @products/*, etc.
# a imports relativos, el runtime no depende de tsconfig-paths). Por eso usa
# SIEMPRE el package.json/yarn.lock raíz (contiene la unión de dependencias de
# todos los servicios) — un tsc de programa completo necesita poder resolver
# cualquier archivo alcanzado por el include, no solo lo que un servicio
# puntual importa en runtime.
#
# ARG SERVICE_MAIN: entrypoint compilado a correr, ej.
#   dist/microservices/products/main.js
#   dist/microservices/main.js            (api-gateway)

FROM node:20-alpine AS deps
WORKDIR /usr/src/app

RUN apk add --no-cache vips-dev python3 make g++ libc6-compat

COPY package*.json ./
COPY yarn.lock ./
COPY nest-cli.json ./
COPY tsconfig.json ./
COPY tsconfig.prod.json ./
COPY tsconfig.paths.json ./

RUN yarn config set network-timeout 600000 && \
    yarn config set registry https://registry.npmjs.org/ && \
    yarn install --network-timeout 600000 --ignore-engines

FROM deps AS build
WORKDIR /usr/src/app

COPY api-gateway/ ./api-gateway/
COPY microservices/ ./microservices/
COPY shared/ ./shared/

RUN npx tsc -p tsconfig.prod.json && \
    npx tsc-alias -p tsconfig.prod.json

FROM node:20-alpine AS runtime
WORKDIR /usr/src/app
ARG SERVICE_MAIN

RUN apk add --no-cache vips libc6-compat curl

COPY --from=deps /usr/src/app/node_modules ./node_modules
COPY --from=build /usr/src/app/dist ./dist

ENV NODE_ENV=production
ENV SERVICE_MAIN=${SERVICE_MAIN}

CMD ["sh", "-c", "node ${SERVICE_MAIN}"]
