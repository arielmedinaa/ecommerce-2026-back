# ---- deps: instala dependencias (mail no usa sharp/libvips, no hace falta) ----
FROM node:20-alpine AS deps
WORKDIR /usr/src/app

RUN apk add --no-cache \
    python3 \
    make \
    g++ \
    libc6-compat

COPY microservices/mail/package*.json ./
COPY yarn.lock ./
COPY tsconfig.json ./
COPY tsconfig.paths.json ./

RUN yarn install --network-timeout 600000

# ---- runtime: mismas devDependencies (nodemon/ts-node hacen hot-reload del
# código fuente, no hay build de por medio), pero SIN el toolchain de
# compilación (python3/make/g++) que solo se necesitaba para instalar
# node_modules — ahorra varios cientos de MB por imagen ----
FROM node:20-alpine
WORKDIR /usr/src/app

RUN apk add --no-cache libc6-compat

RUN npm install -g nodemon ts-node tsconfig-paths

COPY --from=deps /usr/src/app/node_modules ./node_modules
COPY microservices/mail/package*.json ./
COPY yarn.lock ./
COPY tsconfig.json ./
COPY tsconfig.paths.json ./

COPY microservices/mail/ ./microservices/mail/
COPY microservices/auth/schemas/ ./microservices/auth/schemas/
COPY shared/ ./shared/

EXPOSE 3108

CMD ["yarn", "start:dev:mail"]
